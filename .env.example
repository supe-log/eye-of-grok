# xAI key for POST /api/orgs/:id/analyze (Grok 4.6). Without it, a heuristic plan still runs.
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Logan's /u/mine write secret (Bearer for POST /api/orgs/mine/snapshot and MCP writes to mine).
# Local default if unset: hackathon-demo. On Vercel, set this — do not rely on the local default
# as the write path for other people's orgs. Other slugs mint their own eog_ tokens on claim.
INGEST_TOKEN=hackathon-demo

# Neon Postgres (primary durable store + revision history). Pulled by `vercel env pull`.
DATABASE_URL=

# Public site origin used in Bot share prompts (set this after deploy)
NEXT_PUBLIC_APP_URL=https://eye-of-grok.vercel.app

# Optional secondary store if DATABASE_URL is unset. Prefer Neon in production.
# BLOB_READ_WRITE_TOKEN=

# Optional override for the local filesystem store root (tests use this).
# EYE_OF_GROK_DATA_DIR=
