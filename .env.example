# xAI key for POST /api/orgs/:id/analyze (Grok 4.6). Without it, a heuristic plan still runs.
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Shared secret for snapshot POST and MCP writes
INGEST_TOKEN=hackathon-demo

# Neon Postgres (durable org snapshots). Pulled by `vercel env pull`.
DATABASE_URL=

# Public site origin used in Bot share prompts (set this after deploy)
NEXT_PUBLIC_APP_URL=
